# ---------- Supabase ----------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon key is public: it is served to the dashboard so users can sign in.
SUPABASE_ANON_KEY=your-anon-key
# Service role key is SECRET: backend only, never ship it to a browser.
SUPABASE_SERVICE_KEY=your-service-role-key
# Project Settings -> API -> JWT Secret (used to verify user tokens, HS256).
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_BUCKET=inspections

# ---------- Auth ----------
# true  = every API call needs a Supabase user token (use this in production)
# false = anonymous access (local demo only)
AUTH_REQUIRED=true

# ---------- Inspection engine ----------
# "auto" = cuda if available, else cpu
DEVICE=auto
# Path or name of YOLO weights. yolov8n.pt downloads automatically (COCO classes:
# cell phone, laptop, clock, keyboard, tv, mouse, remote...). For production, point
# this at your own fine-tuned weights (see scripts/train_detector.py).
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF=0.35
# Frame size fed to the anomaly model (square). Smaller = faster.
ANOMALY_IMAGE_SIZE=256
ANOMALY_BANK_DIR=models/anomaly
# Verdict thresholds on normalized anomaly score (score / calibrated threshold).
ANOMALY_FAIL_RATIO=1.0
ANOMALY_REVIEW_RATIO=0.8
# FAIL needs a trained bank for the product, and a photo not wildly unlike the bank's (ratio below this). Else REVIEW.
REQUIRE_BANK_FOR_FAIL=true
ANOMALY_TRUST_RATIO=6.5

# ---------- Health screening ----------
SCREENING_MODEL_DIR=models/screening
# Saving patient records needs a signed-in user. Set true ONLY for a local demo with AUTH_REQUIRED=false.
ALLOW_ANONYMOUS_PATIENTS=false

# ---------- Server ----------
MAX_UPLOAD_MB=15
CORS_ORIGINS=*
LOG_LEVEL=INFO
